@model List<CafeManagement.Web.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
}

<h2 class="mb-3">🛒 Giỏ hàng</h2>

@if (!Model.Any())
{
    <p class="text-muted">Giỏ hàng đang trống.</p>
    <a class="btn btn-dark" asp-controller="Home" asp-action="Index">Xem thực đơn</a>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Món</th>
                <th class="text-end">Đơn giá</th>
                <th style="width:200px">Số lượng</th>
                <th class="text-end">Thành tiền</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Name</td>
                    <td class="text-end">@i.Price.ToString("N0") đ</td>
                    <td>
                        <form method="post" asp-action="Update" class="d-flex gap-1">
                            <input type="hidden" name="productId" value="@i.ProductId" />
                            <input type="number" name="quantity" value="@i.Quantity" min="1" max="50" class="form-control form-control-sm" />
                            <button class="btn btn-sm btn-outline-secondary text-nowrap">Cập nhật</button>
                        </form>
                    </td>
                    <td class="text-end">@i.Total.ToString("N0") đ</td>
                    <td>
                        <form method="post" asp-action="Remove">
                            <input type="hidden" name="productId" value="@i.ProductId" />
                            <button class="btn btn-sm btn-outline-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Tổng cộng</th>
                <th class="text-end">@Model.Sum(i => i.Total).ToString("N0") đ</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <a class="btn btn-outline-dark" asp-controller="Home" asp-action="Index">Tiếp tục chọn món</a>
    <a class="btn btn-dark" asp-action="Checkout">Đặt món</a>
}

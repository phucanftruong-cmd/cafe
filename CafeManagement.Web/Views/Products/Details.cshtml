@model CafeManagement.Data.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-dark mb-3">← Quay lại thực đơn</a>

<div class="card shadow-sm">
    <div class="card-body">
        <span class="badge bg-secondary mb-2">@Model.Category?.Name</span>
        <h2>@Model.Name</h2>
        <p class="text-muted">@Model.Description</p>
        <h4 class="mb-3">@Model.Price.ToString("N0") đ</h4>

        <form method="post" asp-controller="Cart" asp-action="Add" class="d-flex gap-2" style="max-width:260px">
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="number" name="quantity" value="1" min="1" max="50" class="form-control" />
            <button class="btn btn-dark text-nowrap">Thêm vào giỏ</button>
        </form>
    </div>
</div>
